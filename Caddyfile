# This is your Caddy configuration. This default config
# opens a port and serves a static site from the www folder.
# Edit this file according to your needs.
{
    admin off
    persist_config off
    auto_https off
    log {
        format json
    }
    servers {
        trusted_proxies static 0.0.0.0/0 ::/0
    }
}

:8080 {
    log {
        format json
    }

    # api routes go to backend service over private networking
    handle /api/* {
        reverse_proxy light-the-lamp-leagues:8080
    }

    # Everything else goes to client (SPA)
    handle {
        reverse_proxy * client:8080
    }

     # Everything else serves the SPA
    #
    #handle {
    #    root * dist
    #    encode gzip
    #    file_server
    #    try_files {path} /index.html
    #}

    rewrite /health /*

}
